# Vorlage für die lokale Entwicklung: nach .env kopieren (.env wird nicht committet).
# Nur Platzhalter – keine echten Werte in dieser Datei.

# Datenverzeichnis (DB, später Logs). Ohne Angabe: Windows %ProgramData%\network-sniffer, sonst ./data
NS_DATA_DIR=./data

# Dashboard nur auf Loopback. Eine Nicht-Loopback-Adresse wird ohne NS_TLS_CERT/NS_TLS_KEY verweigert.
NS_BIND_HOST=127.0.0.1
NS_PORT=8765

# Paketquelle (ab KAN-13): npcap | replay | none
NS_CAPTURE_SOURCE=none

# Optional: erlaubte Host-Header (JSON-Liste). Standard: 127.0.0.1:<port>, localhost:<port> und <NS_BIND_HOST>:<port>
# Eine gesetzte Liste ersetzt den Standard vollständig.
# NS_ALLOWED_HOSTS=["127.0.0.1:8765", "localhost:8765"]

# Ab KAN-15 Pflicht: zufälliger Wert mit mindestens 32 Zeichen, z. B. erzeugt mit
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# NS_SECRET_KEY=<zufaelliger-wert>
